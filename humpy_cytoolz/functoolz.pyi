def identity[T](x: T) -> T: ...

class _Identity(Protocol):
	def __call__[T](self, x: T) -> T: ...
def apply[**P, T](func: Callable[P, T], *args: P.args, **kwargs: P.kwargs) -> T: ...

@overload
def thread_first[T](val: T) -> T: ...
@overload
def thread_first[T0, T1](val: T0, fn_0: Callable[[T0], T1], /) -> T1: ...
@overload
def thread_first[T0, T1, T2](val: T0, fn_0: Callable[[T0], T1], fn_1: Callable[[T1], T2], /) -> T2: ...
@overload
def thread_first[T, R](val: T, *forms: Callable[[T], R] | tuple[Callable[..., R], *tuple[Any, ...]]) -> R: ...
@overload
def thread_last[T](val: T) -> T: ...
