def thread_last[T0, T1, T2](val: T0, fn_0: Callable[[T0], T1], fn_1: Callable[[T1], T2], /) -> T2: ...
@overload
def thread_last[T, U](val: T, *forms: Callable[[T], U] | tuple[Callable[..., U], *tuple[Any, ...]]) -> U: ...
class curry[**P, T]:
	@overload
	def __init__(self, func: curry[P, T] | partial[T], /, *args: Any, **kwargs: Any) -> None: ...
	@overload
	def __init__(self, func: Callable[P, T], /, *args: Any, **kwargs: Any) -> None: ...
	@property
	def func(self) -> Callable[P, T]: ...
	@property
	def __signature__(self) -> inspect.Signature: ...
	@property
	def args(self) -> tuple[Any, ...]: ...
	@property
	def keywords(self) -> dict[str, Any] | None: ...
	__doc__: str | None
	__name__: str
	def __hash__(self) -> int: ...
	def __eq__(self, other: object) -> bool: ...
	def __ne__(self, other: object) -> bool: ...
	@overload
	def __call__(self, *args: P.args, **kwargs: P.kwargs) -> T: ...
	@overload
	def __call__[First, **Remaining](self: curry[Concatenate[First, Remaining], T], first: First, /) -> curry[Remaining, T]: ...
	@overload
	def __call__[First, Second, **Remaining](
		self: curry[Concatenate[First, Second, Remaining], T], first: First, second: Second, /
	) -> curry[Remaining, T]: ...
	@overload
	def __call__(self, *args: Any, **kwargs: Any) -> curry[P, T]: ...
	def _should_curry(self, args: tuple[Any, ...], kwargs: dict[str, Any], exc: TypeError | None = None) -> bool: ...
	def bind(self, *args: Any, **kwargs: Any) -> curry[P, T]: ...
	def call(self, *args: Any, **kwargs: Any) -> T: ...
	def __get__(self, instance: object | None, owner: type | None) -> curry[P, T]: ...
	def __reduce__(self) -> tuple[Callable[..., Any], CurryState]: ...

def _restore_curry[**P, T](
	cls: type[curry[P, T]],
	func: str | Callable[P, T],
	args: tuple[Any, ...],
	kwargs: Mapping[str, Any] | None,
	is_decorated: bool | None,
) -> curry[P, T] | Callable[P, T]: ...
@curry
def memoize[**P, T, Key: Hashable](
    func: Callable[P, T],
    cache: MutableMapping[Key, T] | None = None,
    key: Callable[[tuple[Any, ...], dict[str, Any]], Key] | None = None,
) -> Callable[P, T]: ...

class Compose:
	first: Callable[..., Any]
	funcs: tuple[Callable[..., Any], ...]

	def __init__(self, *funcs: Callable[..., Any]) -> None: ...
	def __call__(self, *args: Any, **kwargs: Any) -> Any: ...
	def __setstate__(self, state: tuple[Callable[..., Any], ...]) -> None: ...
	__doc__: str

	@property
	def __name__(self) -> str: ...
	def __eq__(self, other: object) -> bool: ...
	def __ne__(self, other: object) -> bool: ...
	def __hash__(self) -> int: ...
	def __get__(self, obj: object | None, objtype: type | None = None) -> Compose: ...
	@property
	def __signature__(self) -> inspect.Signature: ...
	@property
	def __wrapped__(self) -> Callable[..., Any]: ...

