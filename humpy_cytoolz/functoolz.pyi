type CurryState = tuple[type[curry[..., Any]], str | Callable[..., Any], tuple[Any, ...], dict[str, Any] | None, bool | None]
__all__: tuple[str, ...] = (
	'apply',
	'complement',
	'compose',
	'compose_left',
	'curry',
	'do',
