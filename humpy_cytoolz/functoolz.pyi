class complement[**P]:
	def __init__[T](self, func: CanCall[P, T]) -> None: ...
	def __call__(self, *args: P.args, **kwargs: P.kwargs) -> bool: ...

class juxt[**P, T]:
	funcs: tuple[Callable[P, T], ...]

	@overload
	def __init__(self, *funcs: Callable[P, T]) -> None: ...
	@overload
	def __init__(self, funcs: Iterable[Callable[P, T]], /) -> None: ...
	def __call__(self, *args: P.args, **kwargs: P.kwargs) -> tuple[T, ...]: ...

def do[T, Result](func: CanCall[[T], Result], x: T) -> T: ...
@curry
def flip[T, U, R](func: Callable[[T, U], R], a: U, b: T) -> R: ...
def return_none(exc: BaseException) -> None: ...

class excepts[**P, T]:
	@overload
	def __new__[ExceptionType: BaseException, **Parameters, Result](
		cls, exc: type[ExceptionType] | tuple[type[ExceptionType], ...], func: Callable[Parameters, Result],
	) -> excepts[Parameters, Result | None]: ...
	@overload
	def __new__[ExceptionType: BaseException, **Parameters, Result, Value](
		cls, exc: type[ExceptionType] | tuple[type[ExceptionType], ...], func: Callable[Parameters, Result], handler: Callable[[ExceptionType], Value],
	) -> excepts[Parameters, Result | Value]: ...
	def __call__(self, *args: P.args, **kwargs: P.kwargs) -> T: ...
	__doc__: str

	@property
	def __name__(self) -> str: ...
